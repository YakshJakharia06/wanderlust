<% layout("/layouts/boilerplate") %>

<div class="row">
	<h1 class="col-6 offset-3">SingUp on Wanderlust</h1>
	<div class="col-6 offset-3 mb-3">
		<form action="/signup" method="post" class="needs-validation" novalidate>
			<div class="mb-3">
				<label for="username" class="form-label">Username:</label>
				<input name="username" id="username" type="text" class="form-control" placeholder="Enter any username" required>
				<div class="valid-feedback">Username is available</div>
			</div>
			<div class="mb-3">
				<label for="email" class="form-label">Email:</label>
				<input name="email" id="email" type="email" class="form-control" placeholder="Enter email" required>
			</div>
			<div class="mb-3">
				<label for="password" class="form-label">Password:</label>
				<input name="password" id="password" type="password" class="form-control" placeholder="Enter password" required>
			</div>
			<button class="btn btn-success">SingUp</button>
		</form>
	</div>
</div>